# Postgres connection string (same as packages/db/.env)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret used to sign JWTs
JWT_SECRET="change-me"

NODE_ENV="development"

# Allow signing up with role "Admin". Only the integration tests need this; keep it false in production and
# create admins with `pnpm --filter @repo/db promote-admin <username>` instead

ALLOW_ADMIN_SIGNUP="true"

# Origin of the web app, allowed by CORS with credentials
WEB_ORIGIN="http://localhost:3000"

# Port the API listens on
PORT=3001

# apps/ws internal endpoint, told about furniture changes so it can push them live
WS_INTERNAL_URL="http://localhost:3002"
# Shared with apps/ws
INTERNAL_SECRET="change-me-to-a-long-random-string"

# Where admin uploads are written (defaults to ../web/public/uploads, served by the web app)
# UPLOADS_DIR="../web/public/uploads"
