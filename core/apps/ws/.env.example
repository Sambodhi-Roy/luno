# Same database as apps/http
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Must match apps/http so tokens it issues verify here
JWT_SECRET="change-me"

# Port the WebSocket server listens on
PORT=3002

# Where map .tmj files are read from (defaults to ../web/public)
# ASSETS_DIR="../web/public"

# Shared with apps/http, which reports furniture changes to /internal/... on this port
INTERNAL_SECRET="change-me-to-a-long-random-string"
